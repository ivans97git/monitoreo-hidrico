# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# BASE DE DATOS POSTGRESQL (Supabase)
# ============================================
# Para desarrollo local usa estos:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monitoreo_hidrico
DB_USER=postgres
DB_PASSWORD=tu_password

# Para producción con Supabase (o Neon/Render) usa:
# DATABASE_URL=postgres://usuario:contraseña@host:5432/nombre_db?sslmode=require
# (Si usas DATABASE_URL, comenta las líneas DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD)

# ============================================
# AUTENTICACIÓN JWT
# ============================================
# Cambia esto por una cadena larga y aleatoria
JWT_SECRET=super_secreto_cambiar_en_produccion
JWT_EXPIRES_IN=8h

# ============================================
# WHATSAPP BUSINESS API (Meta Cloud API)
# ============================================
# Obtener en https://developers.facebook.com
WHATSAPP_TOKEN=EAAG...tu_token_aqui
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERSION=v17.0
WHATSAPP_VERIFY_TOKEN=tu_token_de_verificacion_webhook

# ============================================
# CORS (URLs permitidas para acceder a la API)
# ============================================
# Separar múltiples orígenes con comas
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,https://TU_USUARIO.github.io

# ============================================
# LÍMITES Y UMBRALES (opcional)
# ============================================
DEFAULT_ALERT_LEVEL=3.5
DEFAULT_CRITICAL_LEVEL=5.0
DEFAULT_RAIN_ALERT=100